@inherits LayoutComponentBase
<FluentLayout Style="margin-top: 10px;">
    <FluentHeader>
        Some Header Text
        <FluentSpacer />
        Aligned to the end
    </FluentHeader>

    <FluentStack Orientation="Orientation.Horizontal" Width="100%">
            <NavMenu />
            <FluentBodyContent>
                @Body
            </FluentBodyContent>
        
    </FluentStack>
    <FluentFooter Style="@("height: 40px; color: white; text-align: center;")">
        Footer Text
    </FluentFooter>
</FluentLayout>