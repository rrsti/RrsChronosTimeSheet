    // private static Icon mnuFinanceiro(bool active = false) => active ? new Icons.Regular.Size24.AppGeneric() : new Icons.Regular.Size24.AppGeneric();

    private static Icon mnuUsuario(bool active = false) => active ? new Icons.Regular.Size24.PeopleAdd() : new Icons.Regular.Size24.PeopleAdd();

