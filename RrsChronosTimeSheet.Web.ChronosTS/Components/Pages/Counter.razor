@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<div role="status" style="padding-bottom: 1em;">
</div>

@code {
    private int currentCount = 0;
    private const Appearance accent = Appearance.Accent;

    private void IncrementCount()
    {
        currentCount++;
    }
}
