<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
	<PackageReference Include="FluentValidation" Version="12.2.0" />
	<PackageReference Include="Microsoft.AspNetCore.JsonPatch" Version="11.0.0" />  
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
	<PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
	<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	<PackageReference Include="Scalar.AspNetCore" Version="2.21.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
	<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RrsChronosTimeSheet.Core.Application\RrsChronosTimeSheet.Core.Application.csproj" />
    <ProjectReference Include="..\RrsChronosTimeSheet.Core.Domain\RrsChronosTimeSheet.Core.Domain.csproj" />
    <ProjectReference Include="..\RrsChronosTimeSheet.Core.Infrastructure.Data\RrsChronosTimeSheet.Core.Infrastructure.Data.csproj" />
    <ProjectReference Include="..\RrsChronosTimeSheet.Core.Infrastructure.IoC\RrsChronosTimeSheet.Core.Infrastructure.IoC.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Config\RrsChronosTimeSheetResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>RrsChronosTimeSheetResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Config\RrsChronosTimeSheetResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>RrsChronosTimeSheetResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
